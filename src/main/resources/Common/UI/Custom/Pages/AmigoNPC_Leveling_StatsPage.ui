$C = "../Common.ui";

@CustomButtonStyle = TextButtonStyle(
  Default: (Background: $C.@DefaultSquareButtonDefaultBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
  Hovered: (Background: $C.@DefaultSquareButtonHoveredBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
  Pressed: (Background: $C.@DefaultSquareButtonPressedBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
  Disabled: (Background: $C.@DefaultSquareButtonDisabledBackground, LabelStyle: $C.@DefaultButtonDisabledLabelStyle),
  Sounds: $C.@ButtonSounds,
);

Group #StatsPage {
  LayoutMode: Top;
  Padding: (Full: 0);

  // BEGIN StatsHeader
  Group #PlayerHeaderRow {
    LayoutMode: Top;
    Padding: (Top: 8, Bottom: 10);

    Group #PlayerHeaderContainer { }

    Label #AvailablePointsLabel {
      Style: (
        FontSize: 20,
        TextColor: #ffffff,
        RenderBold: true
      );
      Anchor: ();
      Text: "Available Stat Points: 0";
      Padding: (Top: 2, Bottom: 5);
    }
  }
  // END StatsHeader

Group #StatsList {
Anchor: (Width: 720);
FlexWeight: 1;
LayoutMode: TopScrolling;
Padding: (Left: 7, Top: 2, Right: 12, Bottom: 4);
ScrollbarStyle: $C.@DefaultScrollbarStyle;

// BEGIN StatsCards
Group {
  LayoutMode: Top;

  // BEGIN StatsCardsSurvivalSection
  // BEGIN StatsSurvivalHealthCard
  Group #HealthGroup {
    Anchor: (Width: 680, Height: 86, Bottom: 3);
    LayoutMode: Left;
    Padding: (Full: 8);
    Background: #1a1a1a(0.5);

    Group #HealthIconContainer {
      Anchor: (Width: 64, Height: 48);
      LayoutMode: Left;
      Group {
        Anchor: (Width: 48, Height: 48);
        Background: #3a3a3a;
        Padding: (Left: 2, Top: 2, Right: 2, Bottom: 2);
        Group {
          Anchor: (Width: 44, Height: 44);
          Background: (Color: #2a2a2a(0.8));
          ItemIcon #HealthIcon {
            Anchor: (Left: 2, Top: 2, Width: 40, Height: 40);
          }
        }
      }
    }

    Group {
      LayoutMode: Top;
      Padding: (Left: 4, Right: 5);

      Label #HealthAllocation {
        Style: (
          FontSize: 16,
          TextColor: #ffffff,
          RenderBold: true
        );
        Anchor: (Width: 340, Height: 20);
        Text: "Health";
        Padding: (Bottom: 2);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Width: 340);

        Label #HealthPoints {
          Style: (FontSize: 12, TextColor: #b8c4d0, RenderBold: false);
          Anchor: (Height: 16);
          Text: "Points: ";
          Padding: (Bottom: 2, Right: 2);
        }

        Label #HealthPointsNum {
          Style: (FontSize: 12, TextColor: #e8c030, RenderBold: false);
          Anchor: (Height: 16);
          Text: "0";
          Padding: (Bottom: 2, Right: 4);
        }

        Label #HealthPointsPending {
          Style: (FontSize: 12, TextColor: #90ee90, RenderBold: true);
          Anchor: (Height: 16);
          Text: "";
          Padding: (Bottom: 2);
          Visible: false;
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Width: 340);

        Label #HealthValue {
          Style: (FontSize: 12, TextColor: #b8c4d0, RenderBold: false);
          Anchor: (Height: 16);
          Text: "Value: ";
          Padding: (Bottom: 2, Right: 2);
        }

        Label #HealthValueNum {
          Style: (FontSize: 12, TextColor: #e8c030, RenderBold: false);
          Anchor: (Height: 16);
          Text: "0 HP";
          Padding: (Bottom: 2, Right: 4);
        }

        Label #HealthValuePending {
          Style: (FontSize: 12, TextColor: #90ee90, RenderBold: true);
          Anchor: (Height: 16);
          Text: "";
          Padding: (Bottom: 2);
          Visible: false;
        }
      }

      Label #HealthDescription {
        Style: (
          FontSize: 12,
          TextColor: #b0b8c0,
          RenderBold: false
        );
        Anchor: (Width: 340);
        Text: "";
      }
    }

    Group {
      FlexWeight: 1;
    }

    Group {
      LayoutMode: Left;
      Padding: (Left: 0, Right: 0);

      $C.@CancelTextButton #HealthDecrement5 {
        Anchor: (Width: 50, Height: 35);
        Padding: (Left: 4, Right: 4, Top: 2, Bottom: 2);
        Text: "-5";
        Visible: false;
      }

      Group {
        Anchor: (Width: 5, Height: 35);
      }

      $C.@CancelTextButton #HealthDecrement1 {
        Anchor: (Width: 50, Height: 35);
        Padding: (Left: 4, Right: 4, Top: 2, Bottom: 2);
        Text: "-1";
        Visible: false;
      }

      Group {
        Anchor: (Width: 10, Height: 35);
      }

      $C.@TextButton #HealthIncrement1 {
        Anchor: (Width: 50, Height: 35);
        Padding: (Left: 4, Right: 4, Top: 2, Bottom: 2);
        Text: "+1";
        Style: @CustomButtonStyle;
      }

      Group {
        Anchor: (Width: 5, Height: 35);
      }

      $C.@TextButton #HealthIncrement5 {
        Anchor: (Width: 50, Height: 35);
        Padding: (Left: 4, Right: 4, Top: 2, Bottom: 2);
        Text: "+5";
        Style: @CustomButtonStyle;
        Visible: false;
      }
    }
  }
