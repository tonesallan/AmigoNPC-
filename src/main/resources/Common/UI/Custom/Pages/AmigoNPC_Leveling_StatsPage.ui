          Style: (FontSize: 12, TextColor: #e8c030, RenderBold: false);
          Anchor: (Height: 16);
          Text: "0";
          Padding: (Bottom: 2, Right: 4);
        }

        Label #WoodcuttingValuePending {
          Style: (FontSize: 12, TextColor: #90ee90, RenderBold: true);
          Anchor: (Height: 16);
          Text: "";
          Padding: (Bottom: 2);
          Visible: false;
        }
      }

      Label #WoodcuttingDescription {
        Style: (
          FontSize: 12,
          TextColor: #b0b8c0,
          RenderBold: false
        );
        Anchor: (Width: 340);
        Text: "";
      }
    }

    Group {
      FlexWeight: 1;
    }

    Group {
      LayoutMode: Left;
      Padding: (Left: 0, Right: 0);

      $C.@CancelTextButton #WoodcuttingDecrement5 {
        Anchor: (Width: 50, Height: 35);
        Padding: (Left: 4, Right: 4, Top: 2, Bottom: 2);
        Text: "-5";
        Visible: false;
      }

      Group {
        Anchor: (Width: 5, Height: 35);
      }

      $C.@CancelTextButton #WoodcuttingDecrement1 {
        Anchor: (Width: 50, Height: 35);
        Padding: (Left: 4, Right: 4, Top: 2, Bottom: 2);
        Text: "-1";
        Visible: false;
      }

      Group {
        Anchor: (Width: 10, Height: 35);
      }

      $C.@TextButton #WoodcuttingIncrement1 {
        Anchor: (Width: 50, Height: 35);
        Padding: (Left: 4, Right: 4, Top: 2, Bottom: 2);
        Text: "+1";
        Style: @CustomButtonStyle;
      }

      Group {
        Anchor: (Width: 5, Height: 35);
      }

      $C.@TextButton #WoodcuttingIncrement5 {
        Anchor: (Width: 50, Height: 35);
        Padding: (Left: 4, Right: 4, Top: 2, Bottom: 2);
        Text: "+5";
        Style: @CustomButtonStyle;
        Visible: false;
      }
    }
  }
  // END StatsGatheringWoodcuttingCard
  // END StatsCardsGatheringSection

}
// END StatsCards
      }

// BEGIN StatsFooter
Label #ErrorLabel {
Style: (
  FontSize: 16,
  TextColor: #ff0000,
  RenderBold: true
);
Anchor: ();
Text: "";
Padding: (Top: 5);
      }

Group {
  LayoutMode: Left;

Group #ResetStatsGroup {
  LayoutMode: Left;
  Visible: true;

  $C.@CancelTextButton #ResetStatsButton {
    Anchor: (Width: 120, Height: 40);
    Text: "RESET ALL";
    Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
  }

  Label #ResetPointsCount {
    Style: (FontSize: 14, TextColor: #e8e8e8, RenderBold: true);
    Anchor: (Left: 8, Top: 12);
    Text: "x0";
  }
      }

Group {
  FlexWeight: 1;
}

$C.@CancelTextButton #CancelButton {
  Anchor: (Width: 100, Height: 40);
  Text: "Cancel";
  Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
  Visible: false;
}

$C.@TextButton #SaveButton {
  Anchor: (Left: 10, Width: 100, Height: 40);
  Text: "Save";
  Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
  Style: @CustomButtonStyle;
  Visible: false;
}
      }
// END StatsFooter
}
