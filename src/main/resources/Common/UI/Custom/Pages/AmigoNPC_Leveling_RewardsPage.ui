$C = "../Common.ui";

@CustomButtonStyle = TextButtonStyle(
  Default: (Background: $C.@DefaultSquareButtonDefaultBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
  Hovered: (Background: $C.@DefaultSquareButtonHoveredBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
  Pressed: (Background: $C.@DefaultSquareButtonPressedBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
  Disabled: (Background: $C.@DefaultSquareButtonDisabledBackground, LabelStyle: $C.@DefaultButtonDisabledLabelStyle),
  Sounds: $C.@ButtonSounds,
);

Group #RewardsPage {
  Visible: false;
  LayoutMode: Top;
  Padding: (Full: 0);

  Group {
    LayoutMode: Top;
    Padding: (Top: 10, Bottom: 10);

    Group #PlayerHeaderContainer { }
  }

  // BEGIN RewardsHeader
  Group #RewardsHeader {
    LayoutMode: Left;
    Anchor: (Width: 660, Height: 35);
    Background: #1a2332(0.8);
    Padding: (Left: 15, Right: 0, Top: 8, Bottom: 8);

    Label #RewardsHeaderLevel {
      Style: (
        FontSize: 14,
        TextColor: #ffffff,
        RenderBold: true
      );
      Anchor: (Width: 76);
      Text: "Level";
    }

    Label #RewardsHeaderItems {
      Style: (
        FontSize: 14,
        TextColor: #ffffff,
        RenderBold: true
      );
      Anchor: (Width: 240);
      Text: "Rewards";
    }

    Label #RewardsHeaderAdditional {
      Style: (
        FontSize: 14,
        TextColor: #ffffff,
        RenderBold: true
      );
      Anchor: (Width: 194);
      Text: "Addittional";
    }

    Group {
      FlexWeight: 1;
    }

    Group {
      LayoutMode: Left;
      Anchor: (Width: 120);
      Padding: (Left: 4, Right: 4);
      Label #RewardsHeaderStatus {
        Style: (
          FontSize: 14,
          TextColor: #ffffff,
          RenderBold: true
        );
        Anchor: (Width: 96);
        Text: "Status";
      }
    }
  }
  // END RewardsHeader

  Group #RewardsList {
    Anchor: (Width: 660);
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    Padding: (Left: 0, Top: 5, Right: 0, Bottom: 0);
    ScrollbarStyle: $C.@DefaultScrollbarStyle;

    Group #RewardRows {
      LayoutMode: Top;
    }
  }

  // BEGIN RewardsFooter
  Group {
    LayoutMode: Left;
    Padding: (Top: 10);

    Group {
      FlexWeight: 1;
    }

    $C.@TextButton #ClaimAllButton {
      Visible: false;
      Anchor: (Width: 120, Height: 40);
      Text: "Claim All";
      Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
      Style: @CustomButtonStyle;
    }
  }
  // END RewardsFooter
}
